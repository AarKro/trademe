# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are already in app/.env (committed, public).
# The variables below are SECRET: they only go into Vercel → Settings → Environment Variables,
# plus the two Supabase values from app/.env.

# --- Server only (Vercel API routes). Set these in Vercel → Project → Settings → Environment Variables.
# Never prefix them with VITE_ – that would ship them to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe dashboard in TEST MODE → Developers → API keys (starts with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key for the Payment Element in the app (pk_test_…)
VITE_STRIPE_PUBLISHABLE_KEY=
